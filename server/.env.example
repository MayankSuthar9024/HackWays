# Nodemailer SMTP Configuration (Leave empty to log OTP to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Organization Team <no-reply@organization.org>"
