PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection String or individual params
DATABASE_URL=postgresql://postgres:7665@127.0.0.1:5432/org_portal
# Or:
# DB_USER=postgres
# DB_PASSWORD=7665
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=org_portal

# JWT Config
JWT_SECRET=super_secret_jwt_org_portal_key_2026_change_in_prod
JWT_EXPIRES_IN=7d

# Initial Super Admin Details for Seeding
INITIAL_ADMIN_EMAIL=admin@organization.org
INITIAL_ADMIN_PASSWORD=Admin@Org2026!
