{
  "name": "organization-platform",
  "version": "1.0.0",
  "description": "HackWays event and hackathon submission portal powered by Firebase Realtime Database",
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "preview": "npm --prefix client run preview",
    "start": "npm --prefix client run preview",
